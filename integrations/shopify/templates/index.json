        "custom_liquid": "<style>\n  .intro-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: #323232;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    z-index: 9999;\n    margin: 0;\n    padding: 0;\n    border: none;\n    animation: overlayFadeOut 2.6s ease-out forwards;\n    pointer-events: none;\n  }\n  \n  .intro-logo {\n    width: 280px;\n    height: auto;\n    margin: 0;\n    padding: 0;\n    border: none;\n    animation: logoStretchPhases 2.6s ease-out forwards;\n  }\n  \n  @media (min-width: 768px) {\n    .intro-logo {\n      width: 400px;\n    }\n  }\n  \n  @keyframes logoStretchPhases {\n    0% {\n      transform: scaleX(0.85);\n    }\n    76.92% {\n      transform: scaleX(1.0);\n    }\n    100% {\n      transform: scaleX(1.08);\n    }\n  }\n  \n  @keyframes overlayFadeOut {\n    0% {\n      opacity: 1;\n    }\n    76.92% {\n      opacity: 1;\n    }\n    100% {\n      opacity: 0;\n      visibility: hidden;\n    }\n  }\n</style>\n\n<div class=\"intro-overlay\">\n  <img src=\"https://sidekick.shopify.ai/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6MjEyMTQyOTUwOSwicHVyIjoiYmxvYl9pZCJ9fQ==--01125ae5ff2469d8f3272b36f537c8fa76ead821/Officially...White.png\" alt=\"Pfusch Logo\" class=\"intro-logo\" />\n</div>",
